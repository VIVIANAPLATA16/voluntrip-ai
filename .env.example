# Voluntrip AI — Environment Variables
# Copy to .env.local and fill in values. Never commit secrets.

# AI mode: true = mock responses (no API keys needed)
MOCK_AI=true

# Client flag: set to false to route NAVI through /api/navi (server-side Azure)
NEXT_PUBLIC_MOCK_AI=true

# Azure OpenAI (required when MOCK_AI=false)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# Azure Speech (NAVI voice — server-only, /api/navi/speech)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Azure AI Vision (NAVI receipt OCR — server-only, /api/navi/ocr)
AZURE_VISION_ENDPOINT=
AZURE_VISION_KEY=

# Supabase (cloud sync — optional)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Qloo Taste API (server-only — never expose to the browser)
# Leave QLOO_API_KEY empty for labeled demo mode (source: "demo", reason: NO_KEY)
QLOO_API_KEY=
QLOO_API_BASE_URL=https://hackathon.api.qloo.com

# Exchange rates
EXCHANGE_RATE_API_KEY=

# Public app URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
